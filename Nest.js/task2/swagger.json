{
  "openapi": "3.0.0",
  "paths": {
    "/orders": {
      "get": {
        "operationId": "OrdersController_getAllOrders",
        "parameters": [
          {
            "name": "clientId",
            "required": false,
            "in": "query",
            "description": "Filter by client ID",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "paymentMethod",
            "required": false,
            "in": "query",
            "description": "Filter by payment method",
            "schema": {
              "type": "string",
              "enum": [
                "Cash",
                "Visa"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Return all orders matching the criteria.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Order"
                  }
                }
              }
            }
          }
        },
        "summary": "Get all orders with optional filters",
        "tags": [
          "orders"
        ]
      },
      "post": {
        "operationId": "OrdersController_createOrder",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrderDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The order has been successfully created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input payload."
          }
        },
        "summary": "Create a new order",
        "tags": [
          "orders"
        ]
      }
    },
    "/orders/{id}": {
      "get": {
        "operationId": "OrdersController_getOrderById",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Return the order with the specified ID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "404": {
            "description": "Order not found."
          }
        },
        "summary": "Get an order by its ID",
        "tags": [
          "orders"
        ]
      },
      "put": {
        "operationId": "OrdersController_updateOrder",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateOrderDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The order has been successfully updated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input payload."
          },
          "404": {
            "description": "Order not found."
          }
        },
        "summary": "Update an existing order",
        "tags": [
          "orders"
        ]
      },
      "delete": {
        "operationId": "OrdersController_deleteOrder",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "The order has been successfully deleted."
          },
          "404": {
            "description": "Order not found."
          }
        },
        "summary": "Delete an order",
        "tags": [
          "orders"
        ]
      }
    }
  },
  "info": {
    "title": "TechXpress API",
    "description": "TechXpress Order Management API",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "Order": {
        "type": "object",
        "properties": {}
      },
      "CreateOrderDto": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "description": "The order amount"
          },
          "longitude": {
            "type": "number",
            "description": "The longitude coordinate"
          },
          "latitude": {
            "type": "number",
            "description": "The latitude coordinate"
          },
          "clientId": {
            "type": "number",
            "description": "The ID of the client placing the order"
          },
          "paymentMethod": {
            "type": "string",
            "enum": [
              "Cash",
              "Visa"
            ],
            "description": "The payment method (Cash or Visa)"
          }
        },
        "required": [
          "amount",
          "longitude",
          "latitude",
          "clientId",
          "paymentMethod"
        ]
      },
      "UpdateOrderDto": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "description": "The order amount"
          },
          "longitude": {
            "type": "number",
            "description": "The longitude coordinate"
          },
          "latitude": {
            "type": "number",
            "description": "The latitude coordinate"
          },
          "clientId": {
            "type": "number",
            "description": "The ID of the client"
          },
          "paymentMethod": {
            "type": "string",
            "enum": [
              "Cash",
              "Visa"
            ],
            "description": "The payment method (Cash or Visa)"
          }
        }
      }
    }
  }
}